MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=railpulse
MODEL_PATH=models/railpulse_eta_model.pkl
MODEL_VERSION=eta-v2
ENVIRONMENT=development
API_PREFIX=/api/v1
# Comma-separated. Include the ML frontend and the React site, exactly as the
# browser sees them, e.g. http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000
# This key is shared with the Node service: set backend/.env JWT_SECRET to the
# same value. FastAPI issues the tokens; Node only verifies them.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
STAFF_USERNAME=staff
STAFF_PASSWORD=change-me-staff
