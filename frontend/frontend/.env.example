# Copy to .env.local and adjust if the services do not run on these origins.
# Each value must match exactly what the browser sees, because the FastAPI
# CORS allowlist is compared against it.

# The Express API that serves train data.
VITE_API_BASE_URL=http://localhost:5000/api

# The FastAPI service that issues every token. Its CORS_ORIGINS must include
# the origin this site is served from.
VITE_AUTH_BASE_URL=http://localhost:8000/api/v1

# The ML frontend, used for the sign-in handoff and the shared sign-out.
VITE_ML_APP_URL=http://localhost:3000
